# Root env template — copy to .env
# cp .env.example .env

# Postgres (Docker + local)
POSTGRES_USER=timetable
POSTGRES_PASSWORD=timetable_dev_pw
POSTGRES_DB=timetable
DATABASE_URL=postgresql+psycopg://timetable:timetable_dev_pw@localhost:5432/timetable

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# API
API_PORT=8000
SECRET_KEY=change-me-in-prod
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Web
VITE_API_URL=http://localhost:8000

# Solver
SOLVER_TIME_LIMIT_SECONDS=30
